    {
      "type": "text", "id": "ev_eng1_logic_t",
      "x": 1422, "y": 580, "width": 520, "height": 135,
      "text": "for each FOMC decision day:\n  base   = indicator value that day\n  target = day + 30 / 60 / 90\n  match nearest row within +/- 3 days\n  rates   -> absolute change (pts)\n  indices -> percent change (%)",
      "originalText": "for each FOMC decision day:\n  base   = indicator value that day\n  target = day + 30 / 60 / 90\n  match nearest row within +/- 3 days\n  rates   -> absolute change (pts)\n  indices -> percent change (%)",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300011, "version": 1, "versionNonce": 300012,
