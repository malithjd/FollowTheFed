    {
      "type": "text", "id": "ev_eng1_ex_t",
      "x": 1422, "y": 794, "width": 520, "height": 87,
      "text": "2022-03-16  hike +25 bp\n  30-yr mortgage   3.85 -> 5.23    +1.38 pts\n  10-yr Treasury   2.19 -> 3.15    +0.96 pts\n  S&P 500          4358 -> 3901    -10.49 %",
      "originalText": "2022-03-16  hike +25 bp\n  30-yr mortgage   3.85 -> 5.23    +1.38 pts\n  10-yr Treasury   2.19 -> 3.15    +0.96 pts\n  S&P 500          4358 -> 3901    -10.49 %",
      "fontSize": 13, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top",
