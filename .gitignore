# ── Secrets ──────────────────────────────────────────────
.env
.env.local
*.key

# ── Virtual environments ─────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# ── Data (regenerated by notebooks/prototype.ipynb) ───────
# Use dir/* rather than dir/ so the .gitkeep negations below work:
# git cannot re-include a file whose parent directory is excluded.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Tableau working files ────────────────────────────────
*.twbr
*.twb.bak
*.hyper
*.tde
*.log
Book*.twb

# ── OS / editor cruft ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
